# ===== 环境与敏感信息（绝不提交）=====
# 数据库/Redis/密钥等本地配置
.env
*.env
!.env.example

# pi 工具本地配置（agent skills 等）
.pi/

# 数据库备份
db/backup/*.sql

# ===== 素材 / 构建工作区 =====
# PPT 生成与出图工作区（含大量中间产物，不入库）
.ppt_work/

# docs 目录整体不入库：课程参考素材、示例报告、展示 PPT、
# 课程设计报告（md/docx/pdf）、演示脚本、对话历史整理等均为本地材料
docs/

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/
backend/.venv/

# ===== Node =====
node_modules/
frontend/node_modules/
frontend/dist/

# ===== IDE / 系统 =====
.idea/
.vscode/
*.iml
Thumbs.db
.DS_Store

# ===== 日志 =====
*.log
logs/

# ===== 测试输出 =====
backend/tests/last_run.txt
